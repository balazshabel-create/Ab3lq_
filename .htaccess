# ==========================================================================
# Zamárdi Szépségszalon — Apache beállítások
#
# A legtöbb magyar tárhely (cPanel, Plesk) Apache-t használ, így ez a fájl
# feltöltés után magától érvénybe lép. Nginx vagy Netlify/Vercel esetén nem
# kell — ott a szolgáltató felületén állíthatók ugyanezek.
# ==========================================================================

# --- Hibaoldal ---
ErrorDocument 404 /404.html

# --- Alapértelmezett kezdőlap ---
DirectoryIndex index.html

# --- Karakterkódolás ---
AddDefaultCharset UTF-8

# --- Tömörítés (gyorsabb betöltés) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Böngésző-gyorsítótár ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 6 months"
  ExpiresByType image/png             "access plus 6 months"
  ExpiresByType image/webp            "access plus 6 months"
  ExpiresByType image/svg+xml         "access plus 6 months"
  # A HTML maradjon friss, hogy a módosítások azonnal látszódjanak
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# --- Biztonsági fejlécek ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==========================================================================
# AZ ADMIN FELÜLET VÉDELME  —  erősen ajánlott!
#
# Az admin belépője csak a böngészőben ellenőriz, ezért önmagában nem véd.
# Amíg nincs szerveroldali bejelentkezés, tegye jelszó mögé az admin
# oldalakat. Két lépés:
#
#   1. A tárhely vezérlőpultján hozzon létre egy .htpasswd fájlt
#      (cPanel: „Directory Privacy” / „Jelszavas védelem”), vagy parancssorban:
#         htpasswd -c /home/FELHASZNALO/.htpasswd admin
#
#   2. Törölje az alábbi blokk elejéről a # jeleket, és írja át az elérési utat.
# ==========================================================================

# <FilesMatch "^admin(-belepes)?\.html$">
#   AuthType Basic
#   AuthName "Zamardi Szepsegszalon - admin"
#   AuthUserFile /home/FELHASZNALO/.htpasswd
#   Require valid-user
# </FilesMatch>

# --- HTTPS kényszerítése (ha van tanúsítvány; ajánlott bekapcsolni) ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
