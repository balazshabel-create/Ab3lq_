# Másold át `.env` néven, és töltsd ki éles buildhez.
# A .env fájl NINCS verziózva (lásd .gitignore).

# --- AdMob alkalmazás-azonosítók (AdMob konzol > Apps > App settings) ---
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# --- Hirdetési egységek (AdMob konzol > Ad units) ---
ADMOB_ANDROID_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_IOS_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_IOS_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# --- EAS ---
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# --- Opcionális: távoli esemény-ütemezés (online funkció) ---
# Ha üresen hagyod, a játék a beépített helyi esemény-naptárat használja.
SFE_EVENTS_URL=
